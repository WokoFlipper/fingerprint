    "Thumb (left)", "Index (left)", "Middle (left)",
    "Ring (left)", "Little (left)",
    "Thumb (right)", "Index (right)", "Middle (right)",
    "Ring (right)", "Little (right)",
)

SUDO_CMD = "sudo"
PAM_FILES = (
    "/etc/pam.d/system-auth",
    "/etc/pam.d/sudo",
    "/etc/pam.d/su",
    "/etc/pam.d/hyprlock",
