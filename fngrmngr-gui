# ---------- subprocesses ----------

def run(args, password=None, stdin_text=None, timeout=300):
    """Run a command. If password is given — via `sudo -S`.
    stdin_text is appended to stdin (after the sudo password line)."""
    data = ""
    if password is not None:
        data += password + "\n"
    if stdin_text:
        data += stdin_text
    if password is not None or stdin_text is not None:
        return subprocess.run([SUDO_CMD, "-S"] + list(args),
                              capture_output=True, text=True,
                              input=data, timeout=timeout)
    return subprocess.run(list(args), capture_output=True,
                          text=True, timeout=timeout)


def query_fingers():
    """Returns (device, fingerprint name list, device_available)."""
    device, names, ok = None, [], False
    try:
        p = run(["fprintd-list", USER], timeout=30)
    except (subprocess.TimeoutExpired, OSError):
        return "", [], False
    txt = p.stdout + p.stderr
    if "Device at" in txt and "No devices" not in txt and "not found" not in txt.lower():
        ok = True
    m = re.search(r"Fingerprints for user \S+ on (.+?):", txt)
    if m:
        device = m.group(1).strip()
    if not device:
        for line in txt.splitlines():
            if "Device at" in line:
                device = "Fingerprint device"
                break
    for line in txt.splitlines():
        s = line.strip()
        mm = re.fullmatch(r"-\s+#\d+:\s*(\S+)", s)
        if mm and mm.group(1) not in names:
            names.append(mm.group(1))
            continue
        mm = re.fullmatch(r"-\s+(left-[a-z-]+|right-[a-z-]+)", s)
        if mm and mm.group(1) not in names:
            names.append(mm.group(1))
    return device or "Fingerprint device", names, ok


def stderr_tail(p):
    tail = (p.stderr or p.stdout or "").strip()
    lines = [ln.strip() for ln in tail.splitlines() if ln.strip()]
    return "\n".join(lines[-4:]) or "see terminal for details"


def have_device():
    return query_fingers()[2]


# ---------- background work ----------

class AsyncJob:
    def __init__(self, worker, on_done):
        self._fn = worker
        self._on_done = on_done

    def start(self):
        threading.Thread(target=self._worker_, daemon=True).start()

    def _worker_(self):
        try:
            res = self._fn()
        except Exception as exc:  # noqa: BLE001
            res = exc
        GLib.idle_add(lambda: self._on_done(res))
        return res


# ---------- second level: finger picker ----------

class FingerPickerWindow(Gtk.ApplicationWindow):
    def __init__(self, app, parent, title, subtitle, on_pick):
        super().__init__(application=app, title=title, resizable=False,
                         icon_name=APP_ICON, transient_for=parent,
                         modal=True, destroy_with_parent=True)
        self.set_name("fingerprint-win")
        self._on_pick = on_pick

        hb = Gtk.HeaderBar()
        hb.set_show_close_button(True)
        hb.props.title = title
        self.set_titlebar(hb)

        grid = Gtk.Grid(row_homogeneous=True, column_homogeneous=True,
                        row_spacing=8, column_spacing=8)
        for i in range(len(FINGER_NAMES)):
            b = Gtk.Button(label=str(i + 1))
            b.set_name("fingerbtn")
            b.set_tooltip_text(FINGER_RU[i])
            b.connect("clicked", lambda _w, idx=i: self._pick(idx))
            grid.attach(b, i % 2, i // 2, 1, 1)

        sub_lbl = Gtk.Label(label=subtitle, xalign=0)
        back = Gtk.Button(label="← Back")
        back.set_name("backbtn")
        back.connect("clicked", lambda _w: self._close())

        vbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        vbox.set_margin_top(12)
        vbox.set_margin_bottom(12)
        vbox.set_margin_start(14)
        vbox.set_margin_end(14)
        vbox.pack_start(sub_lbl, False, False, 0)
        vbox.pack_start(grid, True, True, 0)
        vbox.pack_start(back, False, False, 0)
        self.add(vbox)
        self.show_all()

    def _pick(self, idx):
        self.destroy()
        self._on_pick(idx)

    def _close(self):
        self.destroy()


# ---------- window ----------

class FingerWindow(Gtk.ApplicationWindow):
    def __init__(self, app):
        super().__init__(application=app, title=APP_TITLE,
                         default_width=400, default_height=250,
                         resizable=False, icon_name=APP_ICON)
        self._active_proc = None
        self._busy = False
        self._closed = False
        self._pam_rows_by_path = {}
        self.set_name("fingerprint-win")
        self.connect("destroy", self._on_destroy)

        hb = Gtk.HeaderBar()
        hb.set_show_close_button(True)
        hb.props.title = APP_TITLE
        self.set_titlebar(hb)

        btn_refresh = Gtk.Button.new_from_icon_name(
            "view-refresh-symbolic", Gtk.IconSize.SMALL_TOOLBAR)
        btn_refresh.set_tooltip_text("Refresh fingerprint list")
        btn_refresh.connect("clicked", lambda *_: self.refresh())
        hb.pack_start(btn_refresh)

        self._count_lbl = Gtk.Label()
        self._count_lbl.get_style_context().add_class("dim-label")
        hb.pack_end(self._count_lbl)

        self._btn_add = self._action_btn("Enroll fingerprint", "addbtn",
                                         self._on_open_add)
        self._btn_verify = self._action_btn("Verify fingerprint",
                                            "verifybtn", self._on_verify)
        self._btn_del = self._action_btn("Delete fingerprint", "delbtn",
                                         self._on_open_del)

        self._btn_del_all = self._action_btn("Delete all",
                                             "delallbtn", self._on_delete_all)
        self._btn_pam = self._action_btn("PAM / system", "pambtn",
                                         self._on_pam)

        grid = Gtk.Grid(row_homogeneous=True, column_homogeneous=True,
                        row_spacing=10, column_spacing=10)
        grid.attach(self._btn_add, 0, 0, 1, 1)
        grid.attach(self._btn_verify, 1, 0, 1, 1)
        grid.attach(self._btn_del, 0, 1, 1, 1)
        grid.attach(self._btn_del_all, 1, 1, 1, 1)
        grid.attach(self._btn_pam, 0, 2, 2, 1)

        vbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        vbox.set_margin_top(14)
        vbox.set_margin_bottom(14)
        vbox.set_margin_start(14)
        vbox.set_margin_end(14)
