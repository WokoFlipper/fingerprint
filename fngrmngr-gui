    # ---------- style / layout ----------

    def apply_theme(self):
        provider = Gtk.CssProvider()
        provider.load_from_data(DARK_CSS)
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(), provider,
            Gtk.STYLE_PROVIDER_PRIORITY_USER + 10)

    def _action_btn(self, label, name, handler):
        b = Gtk.Button(label=label)
        b.set_name(name)
        b.connect("clicked", handler)
        return b

    def _open_picker(self, title, subtitle, cb):
        FingerPickerWindow(self.get_application(), self,
                           title, subtitle, cb)

    def _on_open_add(self, *_):
        if self._busy:
            return
        self._open_picker("Enroll fingerprint",
                          "Select finger to enroll",
                          self._on_pick_add)

    def _on_open_del(self, *_):
        if self._busy:
            return
        self._open_picker("Delete fingerprint",
                          "Select finger to delete",
                          self._on_pick_del)

    def _on_destroy(self, *_):
        self._closed = True
        proc = self._active_proc
        if proc is not None:
            try:
                proc.terminate()
            except Exception:  # noqa: BLE001
                pass

    # ---------- data ----------

    def refresh(self):
        _dev, names, ok = query_fingers()
        self._count_lbl.set_text(f"Fingerprints: {len(names)}")
        for b in (self._btn_add, self._btn_del,
                  self._btn_verify, self._btn_del_all):
            b.set_sensitive(ok)

    # ---------- dialogs ----------

    def _msg(self, title, text, mtype=Gtk.MessageType.INFO):
        dlg = Gtk.MessageDialog(transient_for=self, modal=True,
                                message_type=mtype, buttons=Gtk.ButtonsType.OK)
        dlg.set_title(title)
        dlg.set_markup(f"<b>{GLib.markup_escape_text(title)}</b>\n\n"
                       f"{GLib.markup_escape_text(text)}")
        dlg.run()
        dlg.destroy()

    def _confirm(self, text):
        dlg = Gtk.MessageDialog(transient_for=self, modal=True,
                                message_type=Gtk.MessageType.QUESTION,
                                buttons=Gtk.ButtonsType.YES_NO)
        dlg.set_title("Confirm")
        dlg.set_markup(f"<b>{GLib.markup_escape_text(text)}</b>")
        resp = dlg.run()
        dlg.destroy()
        return resp == Gtk.ResponseType.YES

    def ask_password(self, title, explanation="", hint=""):
        dlg = Gtk.Dialog(title, self, Gtk.DialogFlags.MODAL,
                         ("Cancel", Gtk.ResponseType.CANCEL,
                          "Continue", Gtk.ResponseType.OK))
        box = dlg.get_content_area()
        if explanation:
            lbl = Gtk.Label(label=explanation, xalign=0)
            box.pack_start(lbl, False, False, 4)
        entry = Gtk.Entry()
        entry.set_visibility(False)
        entry.set_input_purpose(Gtk.InputPurpose.PASSWORD)
        entry.set_activates_default(True)
        box.pack_start(entry, False, False, 4)
        if hint:
            hlbl = Gtk.Label(label=hint, xalign=0)
            hlbl.set_halign(Gtk.Align.START)
            hlbl.get_style_context().add_class("dim-label")
            box.pack_start(hlbl, False, False, 4)
        box.show_all()
        dlg.set_default_response(Gtk.ResponseType.OK)
        entry.grab_focus()
        resp = dlg.run()
        pw = entry.get_text() if resp == Gtk.ResponseType.OK else None
        dlg.destroy()
        return pw

    def _progress(self, title, text):
        dlg = Gtk.Dialog(title, self, Gtk.DialogFlags.MODAL, ())
        spinner = Gtk.Spinner()
        spinner.props.hexpand = True
        lbl = Gtk.Label(label=text, xalign=0)
        box = dlg.get_content_area()
        box.set_margin_top(12)
        box.set_margin_bottom(12)
        box.set_margin_start(12)
        box.set_margin_end(12)
        box.pack_start(spinner, False, False, 0)
        box.pack_start(lbl, False, False, 8)
        box.show_all()
        spinner.start()
        return dlg

    # ---------- enroll ----------

    def _on_pick_add(self, idx):
        if self._busy:
            return
        if not have_device():
            self._msg("No device found",
                      "Fingerprint driver not installed or sensor disconnected.",
                      Gtk.MessageType.ERROR)
            return
        self._enroll(FINGER_NAMES[idx], FINGER_RU[idx], password=None)

    def _enroll(self, fname, ru, password):
        self._busy = True
        dlg = self._progress(
            "Enrolling fingerprint",
            f"«{ru}»\n\n"
            "Place your finger repeatedly.\n"
            "Press-type sensor: short presses (no swipe).\n"
            "Do not lift your finger until ready.")
        self._active_proc = None

        def worker():
            cmd = ["timeout", "180"]
            if password is not None:
                cmd += ["sudo", "-S"]
            cmd += ["fprintd-enroll", "-u", USER, "-f", fname]
            data = (password + "\n") if password is not None else None
            proc = subprocess.Popen(
                cmd, stdin=subprocess.PIPE if data is not None else None,
                stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
            self._active_proc = proc
            out, _ = proc.communicate(input=data)
            self._active_proc = None
            return subprocess.CompletedProcess(proc.args, proc.returncode,
                                               out, "")

        def done(p):
            GLib.idle_add(self._enroll_done, dlg, fname, ru, p,
                          password is not None)

        AsyncJob(worker, done).start()

    def _enroll_done(self, dlg, fname, ru, p, used_password):
        try:
            dlg.destroy()
        except Exception:  # noqa: BLE001
            pass
        self._busy = False
        if self._closed:
            return
        if isinstance(p, Exception):
            self._msg("Error", f"Failed to start enrollment: {p}",
                      Gtk.MessageType.ERROR)
            return
        if p.returncode == 0:
            self._msg("Fingerprint enrolled",
                      f"«{ru}» ({fname}) saved for user {USER}.")
            self.refresh()
            return
        if not used_password:
            pw = self.ask_password(
                "Password for enrolling",
                f"Enrolling «{ru}» for user {USER}.",
                "Sudo password only (no fingerprint needed).")
            if pw is not None:
                self._enroll(fname, ru, password=pw)
            else:
                self._msg("Cancelled", "Enrollment cancelled.",
                          Gtk.MessageType.WARNING)
            return
        self._msg("Error", f"Fingerprint not enrolled.\n{stderr_tail(p)}",
                  Gtk.MessageType.ERROR)

    # ---------- verify ----------

    def _on_verify(self, *_):
        if self._busy:
            return
        if not have_device():
            self._msg("No device found",
                      "Fingerprint driver not installed.",
                      Gtk.MessageType.ERROR)
            return
        self._busy = True
        dlg = self._progress(
            "Verify fingerprint",
            "Place an enrolled finger on the sensor.\n"
            "Waiting up to 20 seconds.")
        self._active_proc = None

        def worker():
            proc = subprocess.Popen(
                ["timeout", "20", "fprintd-verify"],
                stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
            self._active_proc = proc
            out, _ = proc.communicate()
            self._active_proc = None
            return subprocess.CompletedProcess(proc.args, proc.returncode,
                                               out, "")

        def done(p):
            GLib.idle_add(self._verify_done, dlg, p)

        AsyncJob(worker, done).start()

    def _verify_done(self, dlg, p):
        try:
            dlg.destroy()
        except Exception:  # noqa: BLE001
            pass
        self._busy = False
        if self._closed:
            return
        if isinstance(p, Exception):
            self._msg("Error", f"Failed to start verification: {p}",
                      Gtk.MessageType.ERROR)
            return
        if p.returncode == 0:
            self._msg("Result", "Match! Fingerprint verified.")
        else:
            self._msg("Result", "No match.",
                      Gtk.MessageType.WARNING)

    # ---------- delete ----------

    def _on_pick_del(self, idx):
        if self._busy:
            return
        if not have_device():
            self._msg("No device found",
                      "Fingerprint driver not installed.",
                      Gtk.MessageType.ERROR)
            return
        fname, ru = FINGER_NAMES[idx], FINGER_RU[idx]
        if not self._confirm(f"Delete fingerprint «{ru}»?"):
            return
        pw = self.ask_password(
            "Password for deletion",
            f"Deleting «{ru}» for user {USER}.",
            "No fingerprint needed.")
        if pw is None:
            return
        self._busy = True
        try:
            p = run(["fprintd-delete", "-u", USER, "-f", fname], password=pw)
        except Exception as exc:  # noqa: BLE001
            self._busy = False
            self._msg("Error", f"Failed to delete: {exc}",
                      Gtk.MessageType.ERROR)
            return
        self._busy = False
        if p.returncode == 0:
            self._msg("Done", f"Fingerprint «{ru}» deleted.")
            self.refresh()
        else:
            self._msg("Error", f"Fingerprint not deleted.\n{stderr_tail(p)}",
                      Gtk.MessageType.ERROR)

    def _on_delete_all(self, *_):
        if self._busy:
            return
        if not self._confirm(
                "Delete ALL fingerprints?\n\nThis cannot be undone."):
            return
        pw = self.ask_password(
            "Password for deleting all",
            "Sudo password only.",
            "No fingerprint needed.")
        if pw is None:
            return
        self._busy = True
        removed = []
        for fname in FINGER_NAMES:
            try:
                p = run(["fprintd-delete", "-u", USER, "-f", fname],
                        password=pw)
                if (isinstance(p, subprocess.CompletedProcess)
                        and p.returncode == 0):
                    removed.append(fname)
            except Exception:  # noqa: BLE001
                continue
        self._busy = False
        if removed:
            self._msg("Done",
                      f"Fingerprints deleted: {len(removed)} of "
                      f"{len(FINGER_NAMES)}.")
            self.refresh()
        else:
            self._msg("Done", "Nothing deleted.",
                      Gtk.MessageType.INFO)

    # ---------- PAM ----------

    def _pam_active(self, f):
        if not os.path.exists(f):
            return False
        try:
            content = open(f, encoding="utf-8", errors="replace").read()
        except OSError:
            return False
        return "pam_fprintd" in content

    def _pam_configure(self, files):
        """Configures the file list. Returns (added, failed)."""
        if not files:
            return [], []
        names = ", ".join(PAM_LABELS.get(f, f) for f in files)
        pw = self.ask_password(
            "Password for PAM",
            f"Enable fingerprint: {names}.",
            "Sudo password only.")
        if pw is None:
            return None, None
        added, failed = [], []
        for f in files:
            try:
                if os.path.exists(f):
                    p = run(["sed", "-i",
                             "2i auth sufficient pam_fprintd.so", f],
                            password=pw)
                elif os.path.basename(f) in ("sudo", "su"):
                    p = run(["tee", f], password=pw,
                            stdin_text="auth sufficient pam_fprintd.so\n"
                                       "auth include system-auth\n")
                else:
                    continue
                if (isinstance(p, subprocess.CompletedProcess)
                        and p.returncode == 0):
                    added.append(f)
                else:
                    failed.append(f)
            except Exception:  # noqa: BLE001
                failed.append(f)
        return added, failed

    def _make_pam_row(self, f):
        active = self._pam_active(f)
        b = Gtk.Button()
        b.set_name("pamok" if active else "pamno")
        b.set_hexpand(True)
        inner = Gtk.Box(spacing=8)
        lbl_name = Gtk.Label(label=PAM_LABELS.get(f, f), xalign=0)
        lbl_name.set_hexpand(True)
        lbl_status = Gtk.Label(label="enabled" if active else "disabled",
                               xalign=1)
        lbl_status.get_style_context().add_class("dim-label")
        inner.pack_start(lbl_name, True, True, 0)
        inner.pack_start(lbl_status, False, False, 0)
        b.add(inner)
        b.connect("clicked", self._pam_toggle, f)
        return b

    def _pam_update_row(self, row, status_lbl):
        active = self._pam_active(row.path)
        row.set_name("pamok" if active else "pamno")
        status_lbl.set_text("enabled" if active else "disabled")

    def _on_pam(self, *_):
        dlg = Gtk.Dialog("PAM / system", self,
                         Gtk.DialogFlags.MODAL,
                         ("Close", Gtk.ResponseType.CLOSE))
        box = dlg.get_content_area()
        vbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        vbox.set_margin_top(12)
        vbox.set_margin_bottom(12)
        vbox.set_margin_start(14)
        vbox.set_margin_end(14)

        hint = Gtk.Label(
            label="Where fingerprint is already used — green frame. "
                  "Click an item to enable it.",
            xalign=0)
        hint.set_halign(Gtk.Align.START)
        hint.get_style_context().add_class("dim-label")
        hint.set_line_wrap(True)
        vbox.pack_start(hint, False, False, 0)

        rows = []
        for f in PAM_FILES:
            row = self._make_pam_row(f)
            row.path = f
            self._pam_rows_by_path[f] = row
            vbox.pack_start(row, False, False, 0)
            rows.append(row)

        btn_all = Gtk.Button(label="Enable fingerprint everywhere")
        btn_all.set_name("pamallbtn")
        btn_all.connect("clicked", self._pam_enable_all, dlg, rows)

        cnt = Gtk.Label()
        cnt.get_style_context().add_class("dim-label")
        cnt.set_halign(Gtk.Align.START)

        vbox.pack_start(btn_all, False, False, 4)
        vbox.pack_start(cnt, False, False, 0)
        box.pack_start(vbox, True, True, 0)

        self._pam_refresh_counter(cnt, rows)
        box.show_all()
        dlg.run()
        dlg.destroy()

    def _pam_refresh_counter(self, cnt, rows):
        active = sum(1 for r in rows if self._pam_row_active(r))
        cnt.set_text(f"Enabled: {active} of {len(rows)}")

    def _pam_row_active(self, row):
        return row.get_name() == "pamok"

    def _status_label(self, row):
        return row.get_children()[0].get_children()[1]

    def _pam_toggle(self, _b, f):
        row = self._pam_rows_by_path.get(f)
        if self._pam_active(f):
            self._msg("Already enabled",
                      f"Fingerprint active: {PAM_LABELS.get(f, f)}.",
                      Gtk.MessageType.INFO)
            return
        added, failed = self._pam_configure([f])
        if added is None:
            return
        if added:
            if row is not None:
                self._pam_update_row(row, self._status_label(row))
            self.refresh()
            self._msg("Done", f"Fingerprint enabled: "
                      f"{PAM_LABELS.get(f, f)}.")
        if failed:
            self._msg("Error",
                      f"Failed to configure: {PAM_LABELS.get(f, f)}.",
                      Gtk.MessageType.ERROR)

    def _pam_enable_all(self, _b, dlg, rows):
        missing = [f for f, row in
                   zip(PAM_FILES, rows) if not self._pam_row_active(row)]
        if not missing:
            self._msg("Done", "Fingerprint enabled everywhere.",
                      Gtk.MessageType.INFO)
            return
        added, failed = self._pam_configure(missing)
        if added is None:
            return
        for f in added:
            row = self._pam_rows_by_path.get(f)
            if row is not None:
                self._pam_update_row(row, self._status_label(row))
        self.refresh()
        if added:
            self._msg("Done",
                      "Enabled:\n" + "\n".join(
                          PAM_LABELS.get(f, f) for f in added))
        if failed:
            self._msg("Error",
                      "Failed to configure:\n" + "\n".join(failed),
                      Gtk.MessageType.ERROR)


class FingerApplication(Gtk.Application):
    def __init__(self):
        super().__init__(application_id="io.github.resty.fngrmngr")
        self._win = None

    def do_startup(self):
        Gtk.Application.do_startup(self)
        Gtk.Window.set_default_icon_name(APP_ICON)
        settings = Gtk.Settings.get_default()
        if settings is not None:
            settings.props.gtk_application_prefer_dark_theme = True

    def do_activate(self):
        if self._win is not None:
            self._win.present()
            return
        self._win = FingerWindow(self)


if __name__ == "__main__":
    app = FingerApplication()
    app.run(None)